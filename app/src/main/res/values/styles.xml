<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        Material Design theme. Material 1.4.0 is the last version that compiles
        against compileSdk 30 and it does not yet ship the Material3 themes, so
        Theme.MaterialComponents.DayNight.NoActionBar is the right base here.
    -->
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryVariant">@color/brand_primary_dark</item>
        <item name="colorOnPrimary">@color/brand_on_primary</item>
        <item name="colorSecondary">@color/brand_accent</item>
        <item name="colorSecondaryVariant">@color/brand_accent</item>
        <item name="colorOnSecondary">@color/brand_on_primary</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:statusBarColor">@color/brand_primary_dark</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Text styles -->
    <style name="TextAppearance.ScreenCircleSearch.Title" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.ScreenCircleSearch.Body" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <style name="TextAppearance.ScreenCircleSearch.SectionTitle" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Cards used on the setup screen -->
    <style name="Widget.ScreenCircleSearch.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">14dp</item>
        <item name="cardElevation">2dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="contentPadding">16dp</item>
    </style>

    <!-- Buttons on the setup screen -->
    <style name="Widget.ScreenCircleSearch.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:minWidth">120dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.ScreenCircleSearch.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minWidth">120dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!--
        Buttons that live inside the system overlay windows. They are rendered
        on top of another app, so they need a solid, high contrast background.
    -->
    <style name="Widget.ScreenCircleSearch.OverlayButton" parent="Widget.MaterialComponents.Button">
        <item name="android:minWidth">96dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="backgroundTint">@color/brand_primary</item>
        <item name="android:textColor">@color/brand_on_primary</item>
        <item name="cornerRadius">24dp</item>
    </style>

    <style name="Widget.ScreenCircleSearch.OverlayButton.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:minWidth">96dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/brand_on_primary</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>

</resources>
