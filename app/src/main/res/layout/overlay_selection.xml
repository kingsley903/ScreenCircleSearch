<?xml version="1.0" encoding="utf-8"?>
<!--
    Full screen overlay shown while the user selects an area.

    Layer order matters:
      1. selectionScreenshot - the frozen screenshot taken before the overlay
         appeared, so the user sees the real content underneath. Its bounds are
         set programmatically to the exact "fit center" rect, which lets
         SelectionShapeView translate touch coordinates into bitmap pixels.
      2. selectionShape - paints the scrim and the selection outline.
      3. The hint text and the action bar, drawn on top of everything.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/selectionRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <ImageView
        android:id="@+id/selectionScreenshot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/app_name"
        android:scaleType="fitCenter" />

    <com.screencirclesearch.SelectionShapeView
        android:id="@+id/selectionShape"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/selectionHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="48dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/hint_background"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp"
        android:text="@string/selection_hint"
        android:textColor="#FFFFFFFF"
        android:textSize="14sp" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="28dp"
        app:cardBackgroundColor="#F21A73E8"
        app:cardCornerRadius="28dp"
        app:cardElevation="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="6dp"
            android:paddingEnd="8dp"
            android:paddingBottom="6dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/selectionCancel"
                style="@style/Widget.ScreenCircleSearch.OverlayButton.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_cancel" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/selectionShapeToggle"
                style="@style/Widget.ScreenCircleSearch.OverlayButton.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_shape_rectangle" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/selectionConfirm"
                style="@style/Widget.ScreenCircleSearch.OverlayButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_extract" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
