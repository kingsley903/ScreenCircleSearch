<?xml version="1.0" encoding="utf-8"?>
<!--
    Configuration of the AccessibilityService.

    canTakeScreenshot="true" is the important bit: without it
    AccessibilityService.takeScreenshot() fails with
    ERROR_TAKE_SCREENSHOT_INCOMPATIBLE on Android 11.

    The service intentionally requests no event types it does not need beyond a
    lightweight window-change notification, which keeps the Play Store privacy
    disclosure (and the review) simple.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds|flagRetrieveInteractiveWindows|flagIncludeNotImportantViews"
    android:canRetrieveWindowContent="true"
    android:canTakeScreenshot="true"
    android:description="@string/accessibility_service_description"
    android:notificationTimeout="100"
    android:summary="@string/accessibility_service_summary" />
