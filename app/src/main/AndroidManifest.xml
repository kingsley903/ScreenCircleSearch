<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.screencirclesearch">
    <!--
        NOTE: the package attribute is what Android Gradle Plugin 7.0.x uses for
        the R / BuildConfig namespace. If you upgrade to AGP 7.3 or newer, remove
        this attribute and add `namespace 'com.screencirclesearch'` to the
        android { } block in app/build.gradle instead - AGP 8 rejects the
        attribute outright.
    -->

    <!--
        INTERNET is only used to hand the recognised text over to the browser for
        the web search step. All OCR runs locally on the device; no image or
        recognised text ever leaves the phone unless the user taps "Search".
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Required to draw the floating bubble, the selection overlay and the
         result panel on top of other applications. Granted by the user through
         the "Display over other apps" settings screen. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- The AccessibilityService needs the BIND_ACCESSIBILITY_SERVICE
         permission. This is NOT a runtime permission: it is granted by the
         system only when the user enables the service in Accessibility
         settings. It must not be requested via requestPermissions(). -->
    <uses-permission android:name="android.permission.BIND_ACCESSIBILITY_SERVICE" />

    <!--
        Legacy external storage. NOT required on API 30: all screenshots are
        kept in the app's private cache directory (getExternalCacheDir() is not
        even used - Context.getCacheDir() is enough), so scoped storage
        restrictions do not apply. The permission is capped at API 28 so that a
        device running Android 11 never asks the user for it.
    -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Tesseract runs on a native library that is loaded at runtime. Declaring
         the ABIs we support keeps Play Store installs filtered correctly. -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            The core of the app. The AccessibilityService is used for two
            reasons:
              1. it is the only API on Android 11 that can take a screenshot of
                 another app (AccessibilityService.takeScreenshot, API 30), and
              2. it keeps our process alive so the floating bubble can be drawn
                 over other apps.
        -->
        <service
            android:name=".CircleSearchService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>

            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>

</manifest>
